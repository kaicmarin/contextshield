# Copie para .env e troque os valores antes de publicar.
# Não use o segredo de desenvolvimento na AWS.
# Demonstração local com Docker: SEED_ENABLED=true e JWT_ALLOW_DEV_SECRET=true
# Publicação: SPRING_PROFILES_ACTIVE=prod, SEED_ENABLED=false, JWT_ALLOW_DEV_SECRET=false
SEED_ENABLED=false
JWT_ALLOW_DEV_SECRET=false
SPRING_PROFILES_ACTIVE=prod
DB_PASSWORD=troque-a-senha-do-postgres
CORE_DB_PASSWORD=troque-a-senha-da-core
THREAT_DB_PASSWORD=troque-a-senha-da-inteligencia
INVESTIGATION_DB_PASSWORD=troque-a-senha-da-investigacao
ML_DB_PASSWORD=troque-a-senha-do-ml
JWT_SECRET=troque-este-segredo-com-32-caracteres-ou-mais
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=http://localhost
