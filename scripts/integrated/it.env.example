# Copie para scripts/integrated/it.env (gitignored). Somente PostgreSQL local IT (ex.: porta 5433).
# Valores abaixo sao fixos de laboratorio, nao de producao.
JWT_SECRET=it-secret-contextshield-32chars-min
JWT_ALLOW_DEV_SECRET=true
CORE_DB_PASSWORD=core-it-pass
ML_DB_PASSWORD=ml-it-pass
THREAT_DB_PASSWORD=threat-it-pass
INVESTIGATION_DB_PASSWORD=investigation-it-pass
DEMO_LOGIN_PASSWORD=contexto
PGHOST=127.0.0.1
PGPORT=5433
# POSTGRES_SUPER_PASSWORD=   # opcional: senha do role postgres no IT local (prove.ps1)